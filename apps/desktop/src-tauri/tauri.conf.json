{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "App Directory",
  "version": "0.1.5",
  "identifier": "com.nhiiml.appdirectory",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "App Directory",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost http: https:; connect-src 'self' ipc: http://ipc.localhost ws: wss: http: https:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$LOCALDATA/AppDirectory/icons/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "NHIIML",
    "copyright": "Copyright © NHIIML",
    "shortDescription": "Launcher for in-house applications",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
