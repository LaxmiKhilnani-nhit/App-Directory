# Copy to .env and fill in. Never commit .env.

POSTGRES_USER=appdir
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=appdir
TZ=Asia/Kolkata

APP_NAME=App Directory
RUST_LOG=info

# Session lifetime for portal/client logins.
SESSION_TTL_DAYS=30

# Seeded once on first start when no super admin exists. Change the password on first login.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login
