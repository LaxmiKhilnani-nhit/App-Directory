# Copy to .env and fill in. Never commit .env.
# The API has no database: all state lives in infra/data (CSV files).

# Bind address and port. Use 0.0.0.0 on the server so the LAN address works.
BIND_ADDR=0.0.0.0
PORT=8090

APP_NAME=App Directory
RUST_LOG=info

# Domain appended to a bare Windows username (ad\user -> user@nhit.co.in).
# The mail_domain setting in settings.csv wins over this value.
MAIL_DOMAIN=nhit.co.in

# Where the CSV files live (the compose file overrides this with /app/data).
DATA_DIR=data

# Optional: where the portable client exe is mounted for /download.
# CLIENT_EXE=release/App Directory.exe
