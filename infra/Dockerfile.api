# syntax=docker/dockerfile:1

# ---------- admin SPA ----------
FROM node:22-bookworm-slim AS admin-build
WORKDIR /repo
RUN corepack enable

COPY package.json pnpm-workspace.yaml ./
COPY packages ./packages
COPY apps/admin ./apps/admin
RUN pnpm install --no-frozen-lockfile --filter @app-directory/admin...
RUN pnpm --filter @app-directory/admin build

# ---------- api ----------
FROM rust:1-slim-bookworm AS api-build
WORKDIR /app

# Cache dependency compilation across source-only changes.
COPY apps/api/Cargo.toml apps/api/Cargo.lock ./
RUN mkdir -p src \
  && printf 'fn main() {}\n' > src/main.rs \
  && cargo build --release \
  && rm -rf src
COPY apps/api/src ./src
RUN touch src/main.rs && cargo build --release

# ---------- runtime ----------
FROM debian:bookworm-slim AS runtime

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --system --uid 10001 --create-home appdir

WORKDIR /app
COPY --from=api-build /app/target/release/app-directory-api /usr/local/bin/app-directory-api
COPY --from=admin-build /repo/apps/admin/dist /app/admin-dist

# The CSV store is mounted here at runtime (see docker-compose.yml). Create it in the image
# too so a bare `docker run` still works.
RUN mkdir -p /app/data /app/client && chown -R appdir:appdir /app/data

ENV ADMIN_DIST=/app/admin-dist \
    DATA_DIR=/app/data \
    PORT=8090 \
    BIND_ADDR=0.0.0.0 \
    RUST_LOG=info

EXPOSE 8090
USER appdir

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8090/api/v1/healthz > /dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/app-directory-api"]
